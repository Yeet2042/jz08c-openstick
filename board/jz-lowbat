#!/bin/sh
# Power off cleanly when running on battery and the charge stays at or below
# THRESHOLD % for two consecutive checks (run every minute by jz-lowbat.timer).
THRESHOLD=${THRESHOLD:-5}
BAT=/sys/class/power_supply/pm8916-bms-vm
CHG=/sys/class/power_supply/pm8916-lbc-chgr
STATE=/run/jz-lowbat.count
# test mode: DRYRUN=1 ignores the charger, uses THRESHOLD as given, shows the
# warning screen and then restores the status screen instead of powering off
DRYRUN=${DRYRUN:-0}

cap=$(cat $BAT/capacity 2>/dev/null) || exit 0
online=$(cat $CHG/online 2>/dev/null || echo 0)
[ "$DRYRUN" = "1" ] && online=0
uv=$(cat $BAT/voltage_now 2>/dev/null || echo 0)

if [ "$online" = "1" ] || [ "$cap" -gt "$THRESHOLD" ]; then
    rm -f $STATE
    exit 0
fi

n=$(( $(cat $STATE 2>/dev/null || echo 0) + 1 ))
echo $n > $STATE
logger -t jz-lowbat "battery ${cap}% ($((uv / 1000)) mV) on battery power, low check $n/2"
[ $n -lt 2 ] && exit 0

logger -t jz-lowbat "battery ${cap}%: powering off"
# tell the user on the TFT before going down
systemctl stop jz-status.service
python3 - <<'PY' 2>/dev/null
from PIL import Image, ImageDraw, ImageFont
f = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 16)
s = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 11)
im = Image.new("RGB", (128, 128), (40, 0, 0)); d = ImageDraw.Draw(im)
d.text((64, 50), "Battery low", font=f, fill=(255, 90, 90), anchor="mm")
d.text((64, 75), "Shutting down...", font=s, fill=(230, 230, 230), anchor="mm")
open("/dev/fb0", "wb").write(im.convert("RGBX").tobytes("raw", "BGRX"))
PY
echo 1 > /sys/class/backlight/jz08c-bl/brightness 2>/dev/null
sleep 5
if [ "$DRYRUN" = "1" ]; then
    logger -t jz-lowbat "dry run: not powering off"
    rm -f $STATE
    systemctl start jz-status.service
    exit 0
fi
systemctl poweroff
